---
import '../styles/global.css';
import '../styles/theme.css';
import { absolute, href, localePath, otherLocale } from '../lib/site';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { locale, title, description, canonicalPath, alternatePath, jsonLd } = Astro.props;
const other = otherLocale(locale);
const labels = locale === 'zh-CN'
  ? {
      timeline: '时间线', explore: '探索', methodology: '方法论', data: '数据', github: 'GitHub', switch: 'English',
      theme: '主题', system: '跟随系统', light: '浅色', dark: '深色',
      nav: '主导航', skip: '跳到主要内容', footer: '以时间线为核心、基于证据。Canonical YAML 同时生成静态网页与机器可读数据。'
    }
  : {
      timeline: 'Timeline', explore: 'Explore', methodology: 'Methodology', data: 'Data', github: 'GitHub', switch: '简体中文',
      theme: 'Theme', system: 'System', light: 'Light', dark: 'Dark',
      nav: 'Primary navigation', skip: 'Skip to main content', footer: 'Timeline-first, evidence-backed. Canonical YAML drives both static pages and machine-readable data.'
    };
const alternate = alternatePath ?? localePath(other);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f7fa" />
    <script is:inline>
      (() => {
        const key = 'ai4math-theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const valid = new Set(['light', 'dark', 'system']);
        let preference = 'system';
        try {
          const saved = localStorage.getItem(key);
          if (saved && valid.has(saved)) preference = saved;
        } catch {}
        const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
        root.dataset.theme = resolved;
        root.dataset.themePreference = preference;
        root.style.colorScheme = resolved;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', resolved === 'dark' ? '#0b1020' : '#f6f7fa');
      })();
    </script>
    <link rel="canonical" href={absolute(canonicalPath)} />
    <link rel="alternate" hreflang={other} href={absolute(alternate)} />
    <link rel="alternate" hreflang="x-default" href={absolute(localePath('en'))} />
    <link rel="alternate" type="application/rss+xml" title="AI4Math Chronicle RSS" href={absolute('feed.xml')} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(canonicalPath)} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="site-shell header-inner">
        <a class="brand" href={href(localePath(locale))}>AI4Math Chronicle <span aria-hidden="true">/</span> AI4Math 大事记</a>
        <nav class="nav" aria-label={labels.nav}>
          <a href={href(localePath(locale))}>{labels.timeline}</a>
          <a href={href(localePath(locale, 'explore'))}>{labels.explore}</a>
          <a href={href(localePath(locale, 'methodology'))}>{labels.methodology}</a>
          <a href={href(localePath(locale, 'data'))}>{labels.data}</a>
          <a href="https://github.com/Charlie-Wang-03/ai4math-chronicle" rel="noreferrer">{labels.github}</a>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-label-theme={labels.theme}
            data-label-system={labels.system}
            data-label-light={labels.light}
            data-label-dark={labels.dark}
            aria-label={`${labels.theme}: ${labels.system}`}
            title={`${labels.theme}: ${labels.system}`}
          >
            <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.5" y="4.5" width="17" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M8 20h8M12 16.5V20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.7" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M18.7 5.3l-1.55 1.55M6.85 17.15L5.3 18.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.4 15.2A7.8 7.8 0 0 1 8.8 4.6 8.2 8.2 0 1 0 19.4 15.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </button>
          <a class="lang-switch" href={href(alternate)} hreflang={other}>{labels.switch}</a>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-shell" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="site-shell footer-inner">
        <span>{labels.footer}</span>
        <a href={href(localePath(locale, 'data'))}>{locale === 'zh-CN' ? '数据与订阅' : 'Data & feeds'}</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const key = 'ai4math-theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const button = document.querySelector('[data-theme-toggle]');
        const meta = document.querySelector('meta[name="theme-color"]');
        const modes = ['system', 'light', 'dark'];
        const valid = new Set(modes);

        const modeLabel = (preference) => {
          if (!(button instanceof HTMLButtonElement)) return preference;
          if (preference === 'light') return button.dataset.labelLight || 'Light';
          if (preference === 'dark') return button.dataset.labelDark || 'Dark';
          return button.dataset.labelSystem || 'System';
        };

        const updateButtonLabel = (preference) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const themeLabel = button.dataset.labelTheme || 'Theme';
          const label = `${themeLabel}: ${modeLabel(preference)}`;
          button.setAttribute('aria-label', label);
          button.title = label;
        };

        const apply = (rawPreference, persist = false) => {
          const preference = valid.has(rawPreference) ? rawPreference : 'system';
          const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
          root.dataset.theme = resolved;
          root.dataset.themePreference = preference;
          root.style.colorScheme = resolved;
          updateButtonLabel(preference);
          if (meta) meta.setAttribute('content', resolved === 'dark' ? '#0b1020' : '#f6f7fa');
          if (persist) {
            try { localStorage.setItem(key, preference); } catch {}
          }
        };

        apply(root.dataset.themePreference || 'system');
        if (button instanceof HTMLButtonElement) {
          button.addEventListener('click', () => {
            const current = root.dataset.themePreference || 'system';
            const index = modes.indexOf(current);
            const next = modes[(index + 1) % modes.length];
            apply(next, true);
          });
        }

        const handleSystemChange = () => {
          if ((root.dataset.themePreference || 'system') === 'system') apply('system');
        };
        if ('addEventListener' in media) media.addEventListener('change', handleSystemChange);
        else if ('addListener' in media) media.addListener(handleSystemChange);
      })();
    </script>
  </body>
</html>
