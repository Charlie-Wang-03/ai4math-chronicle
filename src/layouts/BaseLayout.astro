---
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/brand.css';
import '../styles/responsive.css';
import { absolute, href, localePath, otherLocale } from '../lib/site';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { locale, title, description, canonicalPath, alternatePath, jsonLd } = Astro.props;
const other = otherLocale(locale);
const labels = locale === 'zh-CN'
  ? {
      timeline: '时间线', explore: '搜索与探索', methodology: '标准与方法', about: '关于', data: '数据与订阅', github: 'GitHub', switch: 'English',
      theme: '主题', system: '跟随系统', light: '浅色', dark: '深色', menu: '菜单',
      nav: '主导航', skip: '跳到主要内容',
      footerMission: '一个以时间线为核心、基于证据、可审计且可修正的 AI for Mathematics 历史档案。Canonical YAML 同时生成静态网页与机器可读数据。',
      footerExplore: '浏览', footerProject: '项目', contribute: '参与贡献', releases: '发布版本', citation: '引用',
      footerLicense: '开放源代码项目 · 代码采用 MIT · Chronicle 原创内容与数据汇编采用 CC BY 4.0',
      footerData: '数据与订阅'
    }
  : {
      timeline: 'Timeline', explore: 'Search & Explore', methodology: 'Standards & Methodology', about: 'About', data: 'Data & Feeds', github: 'GitHub', switch: '简体中文',
      theme: 'Theme', system: 'System', light: 'Light', dark: 'Dark', menu: 'Menu',
      nav: 'Primary navigation', skip: 'Skip to main content',
      footerMission: 'A timeline-first, evidence-backed, auditable, and correctable historical archive for AI for Mathematics. Canonical YAML drives both static pages and machine-readable data.',
      footerExplore: 'Explore', footerProject: 'Project', contribute: 'Contribute', releases: 'Releases', citation: 'Citation',
      footerLicense: 'Open-source project · MIT code · CC BY 4.0 original Chronicle content and data compilation',
      footerData: 'Data & feeds'
    };
const alternate = alternatePath ?? localePath(other);
const repositoryUrl = 'https://github.com/Charlie-Wang-03/ai4math-chronicle';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="application-name" content="AI4Math Chronicle" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#e7ebf0" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline>
      (() => {
        const key = 'ai4math-theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const valid = new Set(['light', 'dark', 'system']);
        let preference = 'system';
        try {
          const saved = localStorage.getItem(key);
          if (saved && valid.has(saved)) preference = saved;
        } catch {}
        const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
        root.dataset.theme = resolved;
        root.dataset.themePreference = preference;
        root.style.colorScheme = resolved;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', resolved === 'dark' ? '#0b1020' : '#e7ebf0');
      })();
    </script>
    <link rel="canonical" href={absolute(canonicalPath)} />
    <link rel="alternate" hreflang={other} href={absolute(alternate)} />
    <link rel="alternate" hreflang="x-default" href={absolute(localePath('en'))} />
    <link rel="alternate" type="application/rss+xml" title="AI4Math Chronicle RSS" href={absolute('feed.xml')} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI4Math Chronicle" />
    <meta property="og:locale" content={locale === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(canonicalPath)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>
    <header class="site-header" data-pagefind-ignore>
      <div class="site-shell header-inner">
        <a class="brand" href={href(localePath(locale))} aria-label="AI4Math Chronicle">
          <img class="brand-mark" src={href('logo-mark.svg')} alt="" width="32" height="32" />
          <span class="brand-lockup">
            <span class="brand-name">AI4Math Chronicle</span>
            <span class="brand-local-name">AI4Math 大事记</span>
          </span>
        </a>
        <button class="nav-toggle" type="button" data-nav-toggle aria-controls="primary-nav" aria-expanded="false">
          <span>{labels.menu}</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
          </svg>
        </button>
        <nav class="nav" id="primary-nav" data-site-nav aria-label={labels.nav}>
          <a href={href(localePath(locale))}>{labels.timeline}</a>
          <a href={href(localePath(locale, 'explore'))}>{labels.explore}</a>
          <a href={href(localePath(locale, 'methodology'))}>{labels.methodology}</a>
          <a href={href(localePath(locale, 'about'))}>{labels.about}</a>
          <a href={repositoryUrl} rel="noreferrer">{labels.github}</a>
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            data-label-theme={labels.theme}
            data-label-system={labels.system}
            data-label-light={labels.light}
            data-label-dark={labels.dark}
            aria-label={`${labels.theme}: ${labels.system}`}
            title={`${labels.theme}: ${labels.system}`}
          >
            <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3.5" y="4.5" width="17" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M8 20h8M12 16.5V20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="3.7" fill="none" stroke="currentColor" stroke-width="1.8" />
              <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M18.7 5.3l-1.55 1.55M6.85 17.15L5.3 18.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.4 15.2A7.8 7.8 0 0 1 8.8 4.6 8.2 8.2 0 1 0 19.4 15.2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            </svg>
          </button>
          <a class="lang-switch" href={href(alternate)} hreflang={other}>{labels.switch}</a>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-shell" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="site-shell footer-grid">
        <div class="footer-brand">
          <div class="footer-brand-lockup">
            <img src={href('logo-mark.svg')} alt="" width="34" height="34" />
            <span>AI4Math Chronicle</span>
          </div>
          <p>{labels.footerMission}</p>
        </div>
        <nav class="footer-nav" aria-label={locale === 'zh-CN' ? '页脚导航' : 'Footer navigation'}>
          <div class="footer-group">
            <strong>{labels.footerExplore}</strong>
            <a href={href(localePath(locale))}>{labels.timeline}</a>
            <a href={href(localePath(locale, 'explore'))}>{labels.explore}</a>
            <a href={href(localePath(locale, 'methodology'))}>{labels.methodology}</a>
            <a href={href(localePath(locale, 'about'))}>{labels.about}</a>
            <a href={href(localePath(locale, 'data'))}>{labels.footerData}</a>
          </div>
          <div class="footer-group">
            <strong>{labels.footerProject}</strong>
            <a href={repositoryUrl} rel="noreferrer">GitHub</a>
            <a href={`${repositoryUrl}/blob/main/CONTRIBUTING.md`} rel="noreferrer">{labels.contribute}</a>
            <a href={`${repositoryUrl}/releases`} rel="noreferrer">{labels.releases}</a>
            <a href={`${repositoryUrl}/blob/main/CITATION.cff`} rel="noreferrer">{labels.citation}</a>
          </div>
        </nav>
      </div>
      <div class="site-shell footer-meta">
        <span>{labels.footerLicense}</span>
        <a href={`${repositoryUrl}/blob/main/LICENSE-CONTENT.md`} rel="noreferrer">CC BY 4.0</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const key = 'ai4math-theme';
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const button = document.querySelector('[data-theme-toggle]');
        const meta = document.querySelector('meta[name="theme-color"]');
        const modes = ['system', 'light', 'dark'];
        const valid = new Set(modes);

        const modeLabel = (preference) => {
          if (!(button instanceof HTMLButtonElement)) return preference;
          if (preference === 'light') return button.dataset.labelLight || 'Light';
          if (preference === 'dark') return button.dataset.labelDark || 'Dark';
          return button.dataset.labelSystem || 'System';
        };

        const updateButtonLabel = (preference) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const themeLabel = button.dataset.labelTheme || 'Theme';
          const label = `${themeLabel}: ${modeLabel(preference)}`;
          button.setAttribute('aria-label', label);
          button.title = label;
        };

        const apply = (rawPreference, persist = false) => {
          const preference = valid.has(rawPreference) ? rawPreference : 'system';
          const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
          root.dataset.theme = resolved;
          root.dataset.themePreference = preference;
          root.style.colorScheme = resolved;
          updateButtonLabel(preference);
          if (meta) meta.setAttribute('content', resolved === 'dark' ? '#0b1020' : '#e7ebf0');
          if (persist) {
            try { localStorage.setItem(key, preference); } catch {}
          }
        };

        apply(root.dataset.themePreference || 'system');
        if (button instanceof HTMLButtonElement) {
          button.addEventListener('click', () => {
            const current = root.dataset.themePreference || 'system';
            const index = modes.indexOf(current);
            const next = modes[(index + 1) % modes.length];
            apply(next, true);
          });
        }

        const handleSystemChange = () => {
          if ((root.dataset.themePreference || 'system') === 'system') apply('system');
        };
        if ('addEventListener' in media) media.addEventListener('change', handleSystemChange);
        else if ('addListener' in media) media.addListener(handleSystemChange);
      })();
    </script>
    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-nav-toggle]');
        const nav = document.querySelector('[data-site-nav]');
        const compact = window.matchMedia('(max-width: 760px)');
        if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

        const setOpen = (open) => {
          nav.dataset.open = String(open);
          toggle.setAttribute('aria-expanded', String(open));
        };

        setOpen(false);
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        nav.addEventListener('click', (event) => {
          if (compact.matches && event.target instanceof Element && event.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
        const handleViewportChange = () => {
          if (!compact.matches) setOpen(false);
        };
        if ('addEventListener' in compact) compact.addEventListener('change', handleViewportChange);
        else if ('addListener' in compact) compact.addListener(handleViewportChange);
      })();
    </script>
  </body>
</html>