---
import type { Locale } from '../lib/types';
import { BASE_URL } from '../lib/site';
const { locale } = Astro.props as { locale: Locale };
const t = locale === 'zh-CN'
  ? { placeholder: '搜索事件、系统、问题或方法…', hint: '至少输入 2 个字符；仅搜索事件记录。', unavailable: '搜索索引仅在生产构建后可用。', label: '事件搜索' }
  : { placeholder: 'Search events, systems, problems, or methods…', hint: 'Type at least 2 characters; searches event records only.', unavailable: 'Search index is available after a production build.', label: 'Event search' };
---
<section class="panel search-panel" aria-label={t.label} data-pagefind-ignore>
  <input class="search-input" id={`site-search-${locale}`} type="search" autocomplete="off" placeholder={t.placeholder} aria-label={t.placeholder} />
  <div class="result-count" id={`search-status-${locale}`} role="status" aria-live="polite">{t.hint}</div>
  <ul class="search-results" id={`search-results-${locale}`}></ul>
</section>
<script is:inline define:vars={{ locale, baseUrl: BASE_URL }}>
  const input = document.getElementById(`site-search-${locale}`);
  const status = document.getElementById(`search-status-${locale}`);
  const list = document.getElementById(`search-results-${locale}`);
  let pagefind;
  let timer;

  async function getPagefind() {
    if (pagefind) return pagefind;
    const moduleUrl = `${baseUrl}pagefind/pagefind.js`;
    pagefind = await import(/* @vite-ignore */ moduleUrl);
    await pagefind.options({ baseUrl });
    return pagefind;
  }

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const query = input.value.trim();
      list.replaceChildren();
      if (query.length < 2) {
        status.textContent = locale === 'zh-CN' ? '至少输入 2 个字符；仅搜索事件记录。' : 'Type at least 2 characters; searches event records only.';
        return;
      }
      try {
        const engine = await getPagefind();
        const search = await engine.search(query);
        const results = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
        status.textContent = locale === 'zh-CN' ? `找到 ${search.results.length} 个结果` : `${search.results.length} result${search.results.length === 1 ? '' : 's'}`;
        for (const result of results) {
          const li = document.createElement('li');
          li.className = 'search-result';
          const a = document.createElement('a');
          a.href = result.url;
          a.textContent = result.meta?.title ?? result.url;
          const p = document.createElement('p');
          p.textContent = (result.excerpt ?? '').replace(/<[^>]+>/g, '');
          li.append(a, p);
          list.append(li);
        }
      } catch (error) {
        console.warn('Pagefind unavailable', error);
        status.textContent = locale === 'zh-CN' ? '搜索索引仅在生产构建后可用。' : 'Search index is available after a production build.';
      }
    }, 180);
  });
</script>
