  <circle class="ornament-stroke ornament-stroke-neutral ornament-stroke-faint" cx="116" cy="112" r="72" />
  <path class="ornament-stroke ornament-stroke-neutral" d="M44 112H314" />
  <path class="ornament-stroke ornament-stroke-neutral ornament-stroke-faint" d="M76 178L248 48" />
  <path class="ornament-stroke ornament-stroke-research" d="M116 40A72 72 0 0 1 178 148" />
  <path class="ornament-stroke ornament-stroke-archive" d="M178 148C214 176 258 176 302 150" />
  <path class="ornament-stroke ornament-stroke-neutral ornament-stroke-faint" d="M248 48V184M302 150V194" />

