---
import MultiSelectFilter from './MultiSelectFilter.astro';
import { formatDate, text } from '../lib/events';
import { presentationLabel, presentationOptions } from '../lib/presentation';
import { href, localePath } from '../lib/site';
import type { ChronicleEvent, Locale } from '../lib/types';

const { events, locale } = Astro.props as { events: ChronicleEvent[]; locale: Locale };
const unique = (values: string[]) => [...new Set(values.filter(Boolean))].sort((a, b) => a.localeCompare(b));
const years = [...new Set(events.map((event) => event.dates.event.slice(0, 4)))].sort((a, b) => b.localeCompare(a));
const eventTypes = unique(events.flatMap((event) => event.event_types));
const significanceTiers = unique(events.map((event) => event.significance.tier));
const verificationStatuses = unique(events.map((event) => event.verification.status));
const systems = unique(events.flatMap((event) => event.systems));
const aiRoles = unique(events.map((event) => event.ai_role.level));
const interfaces = unique(events.flatMap((event) => event.interfaces));
const evidenceLevels = unique(events.map((event) => event.verification.evidence_level));
const assurances = unique(events.map((event) => event.verification.formal_assurance));
const noveltyTypes = unique(events.map((event) => event.mathematical_novelty.type));
const organizations = unique(events.flatMap((event) => event.organizations));
const people = unique(events.flatMap((event) => event.people));
const problems = unique(events.flatMap((event) => event.problems));
const methods = unique(events.flatMap((event) => event.methods));
const sourceTypes = unique(events.flatMap((event) => event.sources.map((source) => source.type)));
const artifactKinds = unique(events.flatMap((event) => event.artifacts.map((artifact) => artifact.kind)));
const tags = unique(events.flatMap((event) => event.tags));
const labels = locale === 'zh-CN'
  ? {
      filters: '探索事件', search: '搜索', placeholder: '搜索事件、系统、问题或方法…', searchHint: '全文搜索与下方筛选共同构成一个查询；至少输入 2 个字符。同一字段内多选为“或”，不同字段之间为“且”。', unavailable: '全文搜索索引暂不可用，已回退到当前页面文本匹配。',
      year: '年份', type: '事件类型', significance: '重要性', verification: '验证状态', system: '系统', aiRole: 'AI 角色', interface: '接口', evidenceLevel: '证据等级', assurance: '形式保障', novelty: '数学新颖性', organization: '机构', person: '人物', problem: '问题', method: '方法', sourceType: '来源类型', artifactKind: '工件类型', tag: '标签', sort: '排序', advanced: '高级筛选', active: '当前条件',
      groupEvent: '事件属性', groupEventDesc: '事件本身的级别、数学新颖性与主题标签。',
      groupAiMath: 'AI 与数学', groupAiMathDesc: '所用系统、AI 角色、交互接口与方法。',
      groupActors: '主体与对象', groupActorsDesc: '参与机构、人物以及所处理的数学问题。',
      groupEvidence: '证据与验证', groupEvidenceDesc: '验证状态、证据强度、形式保障与可用工件。',
      all: '全部', selected: '已选', relevance: '相关性', newest: '最新优先', oldest: '最早优先', highest: '重要性优先', events: '个事件', clear: '清除全部',
      date: '日期', event: '事件', classification: '分类', status: '验证', evidence: '证据', primary: '主要证据', details: '详情', noEvidence: '—',
    }
  : {
      filters: 'Explore events', search: 'Search', placeholder: 'Search events, systems, problems, or methods…', searchHint: 'Full-text search and the filters below form one query. Within a facet selections are OR; across facets they are AND. Type at least 2 characters.', unavailable: 'Full-text search is unavailable; falling back to text already rendered on this page.',
      year: 'Year', type: 'Event type', significance: 'Significance', verification: 'Verification', system: 'System', aiRole: 'AI role', interface: 'Interface', evidenceLevel: 'Evidence level', assurance: 'Formal assurance', novelty: 'Mathematical novelty', organization: 'Organization', person: 'Person', problem: 'Problem', method: 'Method', sourceType: 'Source type', artifactKind: 'Artifact type', tag: 'Tag', sort: 'Sort', advanced: 'Advanced filters', active: 'Active conditions',
      groupEvent: 'Event attributes', groupEventDesc: 'The event’s tier, mathematical novelty, and topical tags.',
      groupAiMath: 'AI & mathematics', groupAiMathDesc: 'Systems, AI role, interaction interface, and methods.',
      groupActors: 'Actors & objects', groupActorsDesc: 'Organizations, people, and mathematical problems involved.',
      groupEvidence: 'Evidence & verification', groupEvidenceDesc: 'Verification state, evidence strength, formal assurance, and available artifacts.',
      all: 'All', selected: 'selected', relevance: 'Relevance', newest: 'Newest first', oldest: 'Oldest first', highest: 'Significance first', events: 'events', clear: 'Clear all',
      date: 'Date', event: 'Event', classification: 'Class', status: 'Verification', evidence: 'Evidence', primary: 'Primary evidence', details: 'Details', noEvidence: '—',
    };
const ids = Object.fromEntries([
  'query', 'year', 'type', 'significance', 'verification', 'system', 'ai-role', 'interface', 'evidence', 'assurance', 'novelty', 'organization', 'person', 'problem', 'method', 'source-type', 'artifact-kind', 'tag', 'sort'
].map((key) => [key, `explore-${key}-${locale}`]));
const optionize = (values: string[]) => values.map((value) => ({ value }));
---
<section class="panel explore-filter-panel" data-explore-shell data-pagefind-ignore>
  <div class="filter-head">
    <div>
      <p class="eyebrow">{labels.filters}</p>
      <div class="result-count"><strong><span data-visible-count>{events.length}</span></strong> {labels.events}</div>
    </div>
    <button class="clear-filters" type="button" data-clear-filters>{labels.clear}</button>
  </div>

  <div class="explore-query">
    <label for={ids.query}>{labels.search}</label>
    <input class="search-input" id={ids.query} data-query type="search" autocomplete="off" placeholder={labels.placeholder} />
    <div class="result-count explore-query-status" data-query-status role="status" aria-live="polite">{labels.searchHint}</div>
  </div>

  <div class="explore-basic-controls">
    <MultiSelectFilter id={ids.year} name="year" label={labels.year} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(years)} />
    <MultiSelectFilter id={ids.type} name="type" label={labels.type} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('event_type', eventTypes, locale)} />
    <div class="control"><label for={ids.sort}>{labels.sort}</label><select id={ids.sort} data-sort><option value="newest">{labels.newest}</option><option value="relevance">{labels.relevance}</option><option value="oldest">{labels.oldest}</option><option value="significance">{labels.highest}</option></select></div>
  </div>

  <details class="explore-advanced" data-advanced>
    <summary>{labels.advanced}</summary>
    <div class="explore-advanced-groups">
      <section class="facet-group" data-facet-group="event-attributes">
        <header class="facet-group-head"><h3>{labels.groupEvent}</h3><p>{labels.groupEventDesc}</p></header>
        <div class="facet-group-controls">
          <MultiSelectFilter id={ids.significance} name="significance" label={labels.significance} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('significance', significanceTiers, locale)} />
          <MultiSelectFilter id={ids.novelty} name="novelty" label={labels.novelty} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('mathematical_novelty', noveltyTypes, locale)} />
          <MultiSelectFilter id={ids.tag} name="tag" label={labels.tag} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(tags)} />
        </div>
      </section>

      <section class="facet-group" data-facet-group="ai-mathematics">
        <header class="facet-group-head"><h3>{labels.groupAiMath}</h3><p>{labels.groupAiMathDesc}</p></header>
        <div class="facet-group-controls">
          <MultiSelectFilter id={ids.system} name="system" label={labels.system} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(systems)} />
          <MultiSelectFilter id={ids['ai-role']} name="ai_role" label={labels.aiRole} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('ai_role', aiRoles, locale)} />
          <MultiSelectFilter id={ids.interface} name="interface" label={labels.interface} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('interface', interfaces, locale)} />
          <MultiSelectFilter id={ids.method} name="method" label={labels.method} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(methods)} />
        </div>
      </section>

      <section class="facet-group" data-facet-group="actors-objects">
        <header class="facet-group-head"><h3>{labels.groupActors}</h3><p>{labels.groupActorsDesc}</p></header>
        <div class="facet-group-controls">
          <MultiSelectFilter id={ids.organization} name="organization" label={labels.organization} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(organizations)} />
          <MultiSelectFilter id={ids.person} name="person" label={labels.person} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(people)} />
          <MultiSelectFilter id={ids.problem} name="problem" label={labels.problem} allLabel={labels.all} selectedLabel={labels.selected} options={optionize(problems)} />
        </div>
      </section>

      <section class="facet-group" data-facet-group="evidence-verification">
        <header class="facet-group-head"><h3>{labels.groupEvidence}</h3><p>{labels.groupEvidenceDesc}</p></header>
        <div class="facet-group-controls">
          <MultiSelectFilter id={ids.verification} name="verification" label={labels.verification} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('verification', verificationStatuses, locale)} />
          <MultiSelectFilter id={ids.evidence} name="evidence" label={labels.evidenceLevel} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('evidence_level', evidenceLevels, locale)} />
          <MultiSelectFilter id={ids.assurance} name="formal_assurance" label={labels.assurance} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('formal_assurance', assurances, locale)} />
          <MultiSelectFilter id={ids['source-type']} name="source_type" label={labels.sourceType} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('source_type', sourceTypes, locale)} />
          <MultiSelectFilter id={ids['artifact-kind']} name="artifact_kind" label={labels.artifactKind} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('artifact_kind', artifactKinds, locale)} />
        </div>
      </section>
    </div>
  </details>

  <div class="active-filters" data-active-filters hidden>
    <span class="active-filters-label">{labels.active}</span>
    <div class="active-filter-chips" data-filter-chips></div>
  </div>
</section>

<div class="explore-table-wrap">
  <table class="explore-table" data-explore-list>
    <thead>
      <tr>
        <th scope="col">{labels.date}</th>
        <th scope="col">{labels.event}</th>
        <th scope="col">{labels.classification}</th>
        <th scope="col">{labels.status}</th>
        <th scope="col">{labels.evidence}</th>
        <th scope="col" class="explore-actions-col"><span class="sr-only">{labels.details}</span></th>
      </tr>
    </thead>
    <tbody>
      {events.map((event) => {
        const primary = event.sources.find((source) => source.primary || source.tier === 'S1');
        const eventUrl = href(localePath(locale, `events/${event.slug}`));
        return (
          <tr
            data-event-item
            data-event-url={eventUrl}
            data-date={event.dates.event}
            data-year={event.dates.event.slice(0, 4)}
            data-event-types={event.event_types.join('|')}
            data-significance={event.significance.tier}
            data-verification={event.verification.status}
            data-systems={event.systems.join('|')}
            data-ai-role={event.ai_role.level}
            data-interfaces={event.interfaces.join('|')}
            data-evidence={event.verification.evidence_level}
            data-formal-assurance={event.verification.formal_assurance}
            data-novelty={event.mathematical_novelty.type}
            data-organizations={event.organizations.join('|')}
            data-people={event.people.join('|')}
            data-problems={event.problems.join('|')}
            data-methods={event.methods.join('|')}
            data-source-types={[...new Set(event.sources.map((source) => source.type))].join('|')}
            data-artifact-kinds={[...new Set(event.artifacts.map((artifact) => artifact.kind))].join('|')}
            data-tags={event.tags.join('|')}
          >
            <td class="explore-date"><time datetime={event.dates.event}>{formatDate(event.dates.event, locale)}</time></td>
            <td class="explore-event-cell">
              <a class="explore-title" href={eventUrl}>{text(event.title, locale)}</a>
              <div class="explore-summary">{text(event.summary, locale)}</div>
              {(event.systems.length > 0 || event.organizations.length > 0) && <div class="explore-entities">{[...event.systems.slice(0, 2), ...event.organizations.slice(0, 1)].join(' · ')}</div>}
            </td>
            <td><span class={`badge significance ${event.significance.tier}`}>{presentationLabel('significance', event.significance.tier, locale)}</span><div class="explore-types">{event.event_types.slice(0, 2).map((value) => presentationLabel('event_type', value, locale)).join(' · ')}</div></td>
            <td><span class={`badge ${event.verification.status}`}>{presentationLabel('verification', event.verification.status, locale)}</span></td>
            <td>{primary ? <a class="explore-evidence" href={primary.url} rel="noreferrer">{presentationLabel('source_type', primary.type, locale)} ↗</a> : labels.noEvidence}</td>
            <td class="explore-actions-col"><a class="details-link" href={eventUrl}>{labels.details} →</a></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<script>
  // @ts-nocheck
  const baseUrl = import.meta.env.BASE_URL;
  let pagefindPromise;

  function normalizePath(value) {
    try {
      const path = new URL(value, window.location.origin).pathname;
      return path.endsWith('/') ? path : `${path}/`;
    } catch {
      return value;
    }
  }

  async function getPagefind() {
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        const moduleUrl = `${baseUrl}pagefind/pagefind.js`;
        const engine = await import(/* @vite-ignore */ moduleUrl);
        await engine.options({ baseUrl });
        return engine;
      })();
    }
    return pagefindPromise;
  }

  for (const shell of document.querySelectorAll('[data-explore-shell]')) {
    const list = shell.nextElementSibling?.querySelector('[data-explore-list]');
    if (!list) continue;
    const body = list.querySelector('tbody');
    const items = [...list.querySelectorAll('[data-event-item]')];
    const groups = [...shell.querySelectorAll('[data-multi-filter]')];
    const sort = shell.querySelector('select[data-sort]');
    const input = shell.querySelector('[data-query]');
    const status = shell.querySelector('[data-query-status]');
    const count = shell.querySelector('[data-visible-count]');
    const clearButton = shell.querySelector('[data-clear-filters]');
    const activeWrap = shell.querySelector('[data-active-filters]');
    const chipWrap = shell.querySelector('[data-filter-chips]');
    const advanced = shell.querySelector('[data-advanced]');
    const filters = Object.fromEntries(groups.map((group) => [group.dataset.filter, []]));
    const rank = { H1: 1, H2: 2, H3: 3 };
    const advancedKeys = new Set(['significance', 'verification', 'system', 'ai_role', 'interface', 'evidence', 'formal_assurance', 'novelty', 'organization', 'person', 'problem', 'method', 'source_type', 'artifact_kind', 'tag']);
    const datasetKeys = {
      year: 'year', type: 'eventTypes', significance: 'significance', verification: 'verification', system: 'systems', ai_role: 'aiRole', interface: 'interfaces', evidence: 'evidence', formal_assurance: 'formalAssurance', novelty: 'novelty', organization: 'organizations', person: 'people', problem: 'problems', method: 'methods', source_type: 'sourceTypes', artifact_kind: 'artifactKinds', tag: 'tags'
    };
    let relevanceRank = new Map();
    let timer;
    let requestId = 0;

    function selectedValues(group) {
      return [...group.querySelectorAll('[data-filter-option]:checked')].map((input) => input.value);
    }

    function optionLabel(group, value) {
      const option = [...group.querySelectorAll('[data-filter-option]')].find((input) => input.value === value);
      return option?.closest('label')?.querySelector('span')?.textContent?.trim() || value;
    }

    function updateSummary(group) {
      const summary = group.querySelector('[data-filter-summary]');
      if (!summary) return;
      const values = selectedValues(group);
      if (!values.length) summary.textContent = group.dataset.allLabel || 'All';
      else if (values.length <= 2) summary.textContent = values.map((value) => optionLabel(group, value)).join(', ');
      else summary.textContent = `${values.length} ${group.dataset.selectedLabel || 'selected'}`;
    }

    function syncGroup(group) {
      filters[group.dataset.filter] = selectedValues(group);
      updateSummary(group);
    }

    function setGroupValues(key, values) {
      const group = groups.find((candidate) => candidate.dataset.filter === key);
      if (!group) return;
      const selected = new Set(values);
      for (const option of group.querySelectorAll('[data-filter-option]')) option.checked = selected.has(option.value);
      syncGroup(group);
    }

    function matches(selected, candidates) {
      return !selected.length || selected.some((value) => candidates.includes(value));
    }

    function pagefindFilterState() {
      return Object.fromEntries(Object.entries(filters)
        .filter(([, values]) => values.length)
        .map(([key, values]) => [key, { any: values }]));
    }

    function readUrlState() {
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (input && q) input.value = q;
      for (const group of groups) {
        const allowed = new Set([...group.querySelectorAll('[data-filter-option]')].map((option) => option.value));
        const values = params.getAll(group.dataset.filter).filter((value) => allowed.has(value));
        setGroupValues(group.dataset.filter, values);
      }
      const sortValue = params.get('sort') || '';
      if (sort && [...sort.options].some((option) => option.value === sortValue)) sort.value = sortValue;
      if (advanced && [...advancedKeys].some((key) => filters[key]?.length)) advanced.open = true;
    }

    function syncUrlState() {
      const params = new URLSearchParams();
      const query = input?.value.trim() || '';
      if (query.length >= 2) params.set('q', query);
      for (const [key, values] of Object.entries(filters)) for (const value of values) params.append(key, value);
      if (sort?.value && sort.value !== 'newest') params.set('sort', sort.value);
      const queryString = params.toString();
      const next = `${window.location.pathname}${queryString ? `?${queryString}` : ''}${window.location.hash}`;
      window.history.replaceState(null, '', next);
    }

    function fallbackMatch(item, query) {
      const itemValues = (filterKey) => {
        const datasetKey = datasetKeys[filterKey];
        return (item.dataset[datasetKey] || '').split('|').filter(Boolean);
      };
      const structured = Object.entries(filters).every(([key, selected]) => matches(selected, itemValues(key)));
      const textMatch = !query || item.textContent.toLocaleLowerCase().includes(query.toLocaleLowerCase());
      return structured && textMatch;
    }

    function setVisibility(predicate) {
      let visible = 0;
      for (const item of items) {
        const shown = predicate(item);
        item.classList.toggle('hidden', !shown);
        if (shown) visible += 1;
      }
      if (count) count.textContent = String(visible);
    }

    function sortRows() {
      const mode = sort?.value || 'newest';
      const effectiveQuery = (input?.value.trim().length || 0) >= 2;
      const ordered = [...items].sort((a, b) => {
        if (mode === 'relevance' && effectiveQuery && relevanceRank.size) {
          const aRank = relevanceRank.get(normalizePath(a.dataset.eventUrl || '')) ?? Number.MAX_SAFE_INTEGER;
          const bRank = relevanceRank.get(normalizePath(b.dataset.eventUrl || '')) ?? Number.MAX_SAFE_INTEGER;
          return aRank - bRank || b.dataset.date.localeCompare(a.dataset.date);
        }
        if (mode === 'oldest') return a.dataset.date.localeCompare(b.dataset.date);
        if (mode === 'significance') {
          const byRank = (rank[a.dataset.significance] || 9) - (rank[b.dataset.significance] || 9);
          return byRank || b.dataset.date.localeCompare(a.dataset.date);
        }
        return b.dataset.date.localeCompare(a.dataset.date);
      });
      for (const item of ordered) body?.appendChild(item);
    }

    function renderChips() {
      if (!chipWrap || !activeWrap) return;
      chipWrap.replaceChildren();
      const query = input?.value.trim() || '';
      const entries = [];
      if (query.length >= 2) entries.push(['q', document.documentElement.lang === 'zh-CN' ? '搜索' : 'Search', `“${query}”`, '']);
      for (const group of groups) {
        const label = group.dataset.filterLabel || group.dataset.filter;
        for (const value of filters[group.dataset.filter]) entries.push([group.dataset.filter, label, optionLabel(group, value), value]);
      }
      for (const [key, label, value, clearValue] of entries) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'filter-chip';
        button.dataset.clearKey = key;
        if (clearValue) button.dataset.clearValue = clearValue;
        button.textContent = `${label}: ${value} ×`;
        chipWrap.appendChild(button);
      }
      activeWrap.hidden = entries.length === 0;
      const hasAny = entries.length > 0 || Boolean(query);
      if (clearButton) clearButton.disabled = !hasAny;
    }

    async function apply() {
      const currentRequest = ++requestId;
      const rawQuery = input?.value.trim() || '';
      const query = rawQuery.length >= 2 ? rawQuery : null;
      const pagefindFilters = pagefindFilterState();
      const hasConditions = Boolean(query) || Object.keys(pagefindFilters).length > 0;
      relevanceRank = new Map();

      if (!hasConditions) {
        setVisibility(() => true);
        sortRows();
        renderChips();
        syncUrlState();
        if (status) status.textContent = rawQuery.length === 1
          ? (document.documentElement.lang === 'zh-CN' ? '至少输入 2 个字符。' : 'Type at least 2 characters.')
          : (document.documentElement.lang === 'zh-CN'
              ? '全文搜索与下方筛选共同构成一个查询；同一字段内多选为“或”，不同字段之间为“且”。'
              : 'Full-text search and the filters below form one query. Within a facet selections are OR; across facets they are AND.');
        return;
      }

      try {
        const engine = await getPagefind();
        const search = await engine.search(query, { filters: pagefindFilters });
        const results = await Promise.all(search.results.map((result) => result.data()));
        if (currentRequest !== requestId) return;
        const paths = results.map((result) => normalizePath(result.url));
        const matched = new Set(paths);
        relevanceRank = new Map(paths.map((path, index) => [path, index]));
        setVisibility((item) => matched.has(normalizePath(item.dataset.eventUrl || '')));
        sortRows();
        renderChips();
        syncUrlState();
        if (status) status.textContent = document.documentElement.lang === 'zh-CN'
          ? '全文搜索与多选结构化筛选已合并为当前结果集。'
          : 'Full-text search and multi-select structured filters are combined in the current result set.';
      } catch (error) {
        console.warn('Pagefind unavailable', error);
        const fallbackQuery = query || '';
        setVisibility((item) => fallbackMatch(item, fallbackQuery));
        sortRows();
        renderChips();
        syncUrlState();
        if (status) status.textContent = document.documentElement.lang === 'zh-CN'
          ? '全文搜索索引暂不可用，已回退到当前页面文本匹配。'
          : 'Full-text search is unavailable; falling back to text already rendered on this page.';
      }
    }

    function scheduleApply() {
      window.clearTimeout(timer);
      timer = window.setTimeout(apply, 180);
    }

    for (const group of groups) {
      syncGroup(group);
      group.addEventListener('change', (event) => {
        if (!event.target.matches('[data-filter-option]')) return;
        syncGroup(group);
        void apply();
      });
    }
    readUrlState();
    input?.addEventListener('focus', () => { void getPagefind().catch(() => {}); }, { once: true });
    input?.addEventListener('input', scheduleApply);
    sort?.addEventListener('change', () => {
      sortRows();
      syncUrlState();
    });
    chipWrap?.addEventListener('click', (event) => {
      const button = event.target.closest('[data-clear-key]');
      if (!button) return;
      const key = button.dataset.clearKey;
      if (key === 'q') {
        if (input) input.value = '';
      } else {
        const next = filters[key].filter((value) => value !== button.dataset.clearValue);
        setGroupValues(key, next);
      }
      void apply();
    });
    clearButton?.addEventListener('click', () => {
      if (input) input.value = '';
      for (const group of groups) setGroupValues(group.dataset.filter, []);
      if (sort) sort.value = 'newest';
      if (advanced) advanced.open = false;
      void apply();
    });
    void apply();
  }
</script>