---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, localePath } from '../lib/site';
import type { Locale } from '../lib/types';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh-CN';
const repositoryUrl = 'https://github.com/Charlie-Wang-03/ai4math-chronicle';
const title = zh ? '使用与共建 — AI4Math 大事记' : 'Use & Contribute — AI4Math Chronicle';
const desc = zh
  ? '在研究中引用与复用 AI4Math Chronicle，使用机器可读数据，并通过 GitHub 参与纠错与共同维护。'
  : 'Use AI4Math Chronicle in research and data workflows, or help maintain it through corrections and public contribution.';

const copy = zh
  ? {
      eyebrow: '使用、复用与参与',
      heading: '使用与共建',
      lede: '这里集中提供把 Chronicle 用于研究、数据与 AI 工作流，以及参与公共维护所需的入口。标准如何解释、证据如何判断，仍由“标准与方法”页面负责。',
      choose: '你想怎样使用 Chronicle？',
      chooseNote: '三条路径分别对应研究引用、机器复用和公开共建；详细规则与工具继续保留在各自的专业页面或 GitHub 文档中。',
      citationTitle: '引用与研究',
      citationText: '在论文、报告、课程材料或研究项目中引用 Chronicle。对于需要可复现版本的工作，优先记录 GitHub Release snapshot 或明确访问日期。',
      citationAction: '查看引用信息 →',
      dataTitle: '数据与 AI 工作流',
      dataText: '使用 JSON、NDJSON、JSON Schema、RSS、Sitemap、llms.txt 与 canonical YAML 做分析、检索、知识整理或 AI-assisted workflows。',
      dataAction: '打开数据与订阅 →',
      contributeTitle: '参与共建',
      contributeText: '提交遗漏事件、来源线索、事实纠错、验证更新、翻译修正或网站改进。贡献流程保持 GitHub-native、可审查、可追溯。',
      contributeAction: '阅读贡献指南 →',
      researchHeading: '研究引用',
      researchText: '网站与 main 分支是持续演进的 living corpus；GitHub Releases 提供更适合学术引用和复现的版本快照。Chronicle 原创编辑内容与数据汇编采用 CC BY 4.0。',
      dataHeading: '机器复用',
      dataBody: '“数据与订阅”页面负责具体格式、下载入口、Quick Start、版本说明与许可信息。本页负责把用户导向这些资源，而不重复维护机器接口说明。',
      contributeHeading: '如何参与共建',
      sourceLead: '提交来源线索',
      sourceLeadText: '发现潜在论文、仓库、公告或独立分析，但还不足以形成完整 Event proposal。',
      eventProposal: '提议遗漏事件',
      eventProposalText: '认为 Chronicle 缺少具有历史或领域意义的 AI4Math milestone。',
      correction: '报告事实或来源错误',
      correctionText: '用于日期、事实、来源、翻译、重要性或验证信息等问题。',
      bug: '报告网站问题',
      bugText: '用于导航、搜索、筛选、渲染、可访问性、导出或构建问题。',
      boundaryHeading: '开放，但不是无门槛发布',
      boundaryText: '所有公开贡献都遵循现有编辑标准与 human-in-the-loop review。提交 Issue 或 Pull Request 不保证纳入 Chronicle；H1、争议性验证状态与重大数学正确性 / 优先权判断仍受既有人工 gate 约束。',
    }
  : {
      eyebrow: 'Use, reuse, and participate',
      heading: 'Use & Contribute',
      lede: 'This page brings together the practical ways to use the Chronicle in research, data and AI workflows, or public maintenance. Standards, evidence semantics, and trust interpretation remain the responsibility of Standards & Methodology.',
      choose: 'How do you want to use the Chronicle?',
      chooseNote: 'The three paths cover research citation, machine reuse, and public contribution; detailed rules and tooling remain in their dedicated pages or GitHub documentation.',
      citationTitle: 'Citation & research',
      citationText: 'Cite the Chronicle in papers, reports, teaching materials, or research projects. For reproducible work, prefer a GitHub Release snapshot or record an explicit access date.',
      citationAction: 'View citation metadata →',
      dataTitle: 'Data & AI workflows',
      dataText: 'Use JSON, NDJSON, JSON Schema, RSS, Sitemap, llms.txt, and canonical YAML for analysis, retrieval, knowledge workflows, or AI-assisted research.',
      dataAction: 'Open Data & Feeds →',
      contributeTitle: 'Contribute',
      contributeText: 'Submit missing events, source leads, factual corrections, verification updates, translation fixes, or website improvements through a GitHub-native, reviewable workflow.',
      contributeAction: 'Read the contribution guide →',
      researchHeading: 'Research citation',
      researchText: 'The website and main branch form an evolving living corpus; GitHub Releases provide more reproducible snapshots for academic citation. Original Chronicle editorial content and data compilation are licensed under CC BY 4.0.',
      dataHeading: 'Machine reuse',
      dataBody: 'The Data & Feeds page owns format details, downloads, Quick Start examples, version guidance, and licensing. This page routes users to those resources rather than duplicating machine-interface documentation.',
      contributeHeading: 'How to contribute',
      sourceLead: 'Submit a source lead',
      sourceLeadText: 'You found a paper, repository, announcement, or independent analysis that may matter but is not yet a complete Event proposal.',
      eventProposal: 'Propose a missing event',
      eventProposalText: 'You believe an AI4Math milestone with historical or field significance is missing from the Chronicle.',
      correction: 'Report a factual or sourcing problem',
      correctionText: 'Use this for dates, facts, sources, translations, significance, or verification information that needs review.',
      bug: 'Report a website problem',
      bugText: 'Use this for navigation, search, filtering, rendering, accessibility, export, or build problems.',
      boundaryHeading: 'Open does not mean automatic publication',
      boundaryText: 'All public contributions remain subject to the existing editorial standards and human-in-the-loop review. Opening an Issue or Pull Request does not guarantee inclusion; H1 decisions, high-risk verification states, and material mathematical-correctness or priority judgments remain behind the established human gates.',
    };
---
<BaseLayout
  locale={locale}
  title={title}
  description={desc}
  canonicalPath={localePath(locale, 'use')}
  alternatePath={localePath(zh ? 'en' : 'zh-CN', 'use')}
>
  <header class="prose">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>

  <section class="participation-section" aria-labelledby="use-paths-heading">
    <div class="participation-header">
      <div>
        <p class="eyebrow">{zh ? '三条路径' : 'Three paths'}</p>
        <h2 id="use-paths-heading">{copy.choose}</h2>
      </div>
      <p>{copy.chooseNote}</p>
    </div>
    <div class="participation-grid">
      <article class="participation-card">
        <h3>{copy.citationTitle}</h3>
        <p>{copy.citationText}</p>
        <a href={`${repositoryUrl}/blob/main/CITATION.cff`} rel="noreferrer">{copy.citationAction}</a>
      </article>
      <article class="participation-card">
        <h3>{copy.dataTitle}</h3>
        <p>{copy.dataText}</p>
        <a href={href(localePath(locale, 'data'))}>{copy.dataAction}</a>
      </article>
      <article class="participation-card">
        <h3>{copy.contributeTitle}</h3>
        <p>{copy.contributeText}</p>
        <a href={`${repositoryUrl}/blob/main/CONTRIBUTING${zh ? '.zh-CN' : ''}.md`} rel="noreferrer">{copy.contributeAction}</a>
      </article>
    </div>
  </section>

  <section class="prose">
    <h2>{copy.researchHeading}</h2>
    <p>{copy.researchText}</p>
    <div class="data-links">
      <a class="data-link" href={`${repositoryUrl}/blob/main/CITATION.cff`} rel="noreferrer"><strong>CITATION.cff</strong><span>{zh ? '项目引用元数据。' : 'Project citation metadata.'}</span></a>
      <a class="data-link" href={`${repositoryUrl}/releases`} rel="noreferrer"><strong>GitHub Releases</strong><span>{zh ? '用于引用和复现的版本快照。' : 'Version snapshots for citation and reproducibility.'}</span></a>
      <a class="data-link" href={`${repositoryUrl}/blob/main/LICENSE-CONTENT.md`} rel="noreferrer"><strong>CC BY 4.0</strong><span>{zh ? 'Chronicle 原创编辑内容与数据汇编许可。' : 'License for original Chronicle editorial content and data compilation.'}</span></a>
    </div>

    <h2>{copy.dataHeading}</h2>
    <p>{copy.dataBody}</p>
    <p><a class="button-link" href={href(localePath(locale, 'data'))}>{copy.dataAction}</a></p>

    <h2>{copy.contributeHeading}</h2>
    <div class="data-links">
      <a class="data-link" href={`${repositoryUrl}/issues/new?template=source-lead.yml`} rel="noreferrer"><strong>{copy.sourceLead}</strong><span>{copy.sourceLeadText}</span></a>
      <a class="data-link" href={`${repositoryUrl}/issues/new?template=event-proposal.yml`} rel="noreferrer"><strong>{copy.eventProposal}</strong><span>{copy.eventProposalText}</span></a>
      <a class="data-link" href={`${repositoryUrl}/issues/new?template=correction.yml`} rel="noreferrer"><strong>{copy.correction}</strong><span>{copy.correctionText}</span></a>
      <a class="data-link" href={`${repositoryUrl}/issues/new?template=bug-report.yml`} rel="noreferrer"><strong>{copy.bug}</strong><span>{copy.bugText}</span></a>
    </div>

    <h2>{copy.boundaryHeading}</h2>
    <p>{copy.boundaryText}</p>
  </section>
</BaseLayout>
