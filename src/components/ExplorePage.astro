---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreDirectory from './ExploreDirectory.astro';
import { getAllEvents } from '../lib/events';
import { localePath } from '../lib/site';
import type { Locale } from '../lib/types';
import '../styles/explore.css';
const { locale } = Astro.props as { locale: Locale };
const events = getAllEvents();
const c = locale === 'zh-CN'
 ? {
     title: '搜索与探索事件 — AI4Math 大事记',
     desc: '使用全文搜索、多选结构化筛选与排序来定位和比较 AI4Math Chronicle 的 canonical event records。',
     eyebrow: '搜索与探索',
     heading: '搜索、组合条件并比较事件',
     lede: `在 ${events.length} 条 canonical event records 中全文搜索，并按年份、事件类型、系统、人物、问题、方法与证据条件进行结构化检索。`,
     noteTitle: '这里与时间线有什么不同？',
     note: 'Timeline 回答“接下来发生了什么”，并始终保持历史顺序；Search & Explore 回答“哪些事件符合这些条件”。同一字段内可以多选并按 OR 合并，不同字段之间按 AND 组合，查询仍可通过 URL 分享。',
   }
 : {
     title: 'Search & Explore Events — AI4Math Chronicle',
     desc: 'Use full-text search, multi-select structured filters, and sorting to locate and compare canonical AI4Math Chronicle event records.',
     eyebrow: 'Search & explore',
     heading: 'Search, combine conditions, and compare events',
     lede: `Search all ${events.length} canonical event records, then refine by year, event type, systems, people, problems, methods, or evidence conditions.`,
     noteTitle: 'How is this different from the timeline?',
     note: 'Timeline answers “what happened next?” and preserves chronology. Search & Explore answers “which events match these conditions?” Multiple selections within one facet are OR; different facets combine with AND, and the query remains shareable by URL.',
   };
---
<BaseLayout locale={locale} title={c.title} description={c.desc} canonicalPath={localePath(locale,'explore')} alternatePath={localePath(locale === 'en' ? 'zh-CN' : 'en','explore')}>
  <header class="hero explore-hero">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.heading}</h1>
    <p class="lede">{c.lede}</p>
    <details class="explore-note">
      <summary>{c.noteTitle}</summary>
      <p>{c.note}</p>
    </details>
  </header>
  <ExploreDirectory events={events} locale={locale} />
</BaseLayout>
