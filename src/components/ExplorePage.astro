---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreDirectory from './ExploreDirectory.astro';
import { getAllEvents } from '../lib/events';
import { localePath } from '../lib/site';
import type { Locale } from '../lib/types';
import '../styles/explore.css';
const { locale } = Astro.props as { locale: Locale };
const events = getAllEvents();
const c = locale === 'zh-CN'
 ? {
     title: '事件探索 — AI4Math 大事记',
     desc: '使用全文搜索、结构化筛选与排序来定位和比较 AI4Math Chronicle 的 canonical event records。',
     eyebrow: '事件探索',
     heading: '搜索、组合条件并比较事件',
     lede: `时间线用于理解历史演进；这里把 ${events.length} 条 canonical event records 作为一个可查询目录，用于定向定位、跨字段比较与证据检查。`,
     noteTitle: '这里与时间线有什么不同？',
     note: 'Timeline 回答“接下来发生了什么”，并始终保持历史顺序；Explore 回答“哪些事件符合这些条件”，把全文搜索、结构化筛选、排序与可分享 URL 合并成一个查询。',
   }
 : {
     title: 'Explore Events — AI4Math Chronicle',
     desc: 'Use full-text search, structured filters, and sorting to locate and compare canonical AI4Math Chronicle event records.',
     eyebrow: 'Event exploration',
     heading: 'Search, combine conditions, and compare events',
     lede: `The timeline is for understanding historical progression. This page treats all ${events.length} canonical event records as one queryable directory for targeted retrieval, cross-field comparison, and evidence checks.`,
     noteTitle: 'How is this different from the timeline?',
     note: 'Timeline answers “what happened next?” and preserves chronology. Explore answers “which events match these conditions?” by combining full-text search, structured filters, sorting, and a shareable URL into one query.',
   };
---
<BaseLayout locale={locale} title={c.title} description={c.desc} canonicalPath={localePath(locale,'explore')} alternatePath={localePath(locale === 'en' ? 'zh-CN' : 'en','explore')}>
  <header class="hero explore-hero">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.heading}</h1>
    <p class="lede">{c.lede}</p>
    <aside class="explore-note" aria-label={c.noteTitle}>
      <strong>{c.noteTitle}</strong>
      <span>{c.note}</span>
    </aside>
  </header>
  <ExploreDirectory events={events} locale={locale} />
</BaseLayout>
