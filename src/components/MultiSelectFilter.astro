---
interface Option {
  value: string;
  label?: string;
}

const {
  id,
  name,
  label,
  options,
  allLabel,
  selectedLabel,
} = Astro.props as {
  id: string;
  name: string;
  label: string;
  options: Option[];
  allLabel: string;
  selectedLabel: string;
};
---
<div class="control multi-filter" data-multi-filter data-filter={name} data-filter-label={label} data-all-label={allLabel} data-selected-label={selectedLabel}>
  <span class="multi-filter-label" id={`${id}-label`}>{label}</span>
  <details class="multi-filter-menu">
    <summary aria-labelledby={`${id}-label`} data-filter-summary>{allLabel}</summary>
    <div class="multi-filter-options" role="group" aria-labelledby={`${id}-label`}>
      {options.map((option) => (
        <label class="multi-filter-option">
          <input type="checkbox" value={option.value} data-filter-option />
          <span>{option.label ?? option.value}</span>
        </label>
      ))}
    </div>
  </details>
</div>

<style>
  .multi-filter { min-width: 0; }
  .multi-filter-label {
    display: block;
    margin: 0 0 .25rem;
    color: var(--muted);
    font-size: .76rem;
    font-weight: 680;
  }
  .multi-filter-menu { position: relative; }
  .multi-filter-menu > summary {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    width: 100%;
    cursor: pointer;
    list-style: none;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--surface);
    color: var(--text);
    padding: .65rem .8rem;
    font-size: .9rem;
    user-select: none;
  }
  .multi-filter-menu > summary::-webkit-details-marker { display: none; }
  .multi-filter-menu > summary::after {
    content: '▾';
    flex: 0 0 auto;
    color: var(--muted);
    font-size: .74rem;
    transition: transform .14s ease;
  }
  .multi-filter-menu[open] > summary::after { transform: rotate(180deg); }
  .multi-filter-menu > summary:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 18%, transparent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .multi-filter-menu[open] > summary { border-color: var(--accent); }
  .multi-filter-options {
    position: absolute;
    z-index: 8;
    top: calc(100% + .3rem);
    left: 0;
    right: 0;
    max-height: 260px;
    overflow-y: auto;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    background: var(--surface);
    padding: .3rem;
    box-shadow: 0 10px 24px color-mix(in srgb, var(--text) 13%, transparent);
  }
  .multi-filter-option {
    display: flex;
    align-items: flex-start;
    gap: .55rem;
    border-radius: 2px;
    padding: .42rem .48rem;
    color: var(--text);
    font-size: .84rem;
    cursor: pointer;
  }
  .multi-filter-option:hover { background: color-mix(in srgb, var(--accent-soft) 62%, transparent); }
  .multi-filter-option input { flex: 0 0 auto; margin-top: .18rem; accent-color: var(--accent); }
  .multi-filter-option span { min-width: 0; overflow-wrap: anywhere; }
</style>