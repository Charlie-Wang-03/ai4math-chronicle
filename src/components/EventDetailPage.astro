---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/event-detail.css';
import { formatDate, getEventById, text } from '../lib/events';
import { presentationLabel } from '../lib/presentation';
import { absolute, href, localePath } from '../lib/site';
import type { ChronicleEvent, Locale } from '../lib/types';
const { event, locale } = Astro.props as { event: ChronicleEvent; locale: Locale };
const zh = locale === 'zh-CN';
const other = zh ? 'en' : 'zh-CN';
const canonicalPath = localePath(locale, `events/${event.slug}`);
const eventTitle = text(event.title, locale);
const description = text(event.summary, locale);
const primary = event.sources.filter((source) => source.primary || source.tier === 'S1');
const sourceTypes = [...new Set(event.sources.map((source) => source.type))];
const artifactKinds = [...new Set(event.artifacts.map((artifact) => artifact.kind))];
const relationGroups = [
  [zh ? '更早进展' : 'Earlier developments', event.relationships.predecessors],
  [zh ? '后续进展' : 'Later developments', event.relationships.successors],
  [zh ? '相关里程碑' : 'Related milestones', event.relationships.related],
] as const;
const labels = zh
  ? {
      atGlance: '证据与状态一览', significance: '重要性', verification: '验证状态', evidence: '证据等级', aiRole: 'AI 角色', assurance: '形式保障',
      onPage: '本页导航', startHere: '先读', deeper: '深入记录',
      what: '发生了什么？', why: '为什么重要？', primaryEvidence: '主要证据', contribution: '贡献与验证', technical: '技术细节', sources: '全部来源与工件', relationships: '历史脉络', history: '验证历史', corrections: '更正',
      rationale: '重要性说明：', novelty: '数学新颖性', interface: '接口', aiContribution: 'AI 贡献', humanContribution: '人类贡献', lastReviewed: '最后审阅', systems: '系统', organizations: '机构', problems: '数学问题', methods: '方法', accessed: '访问于', artifact: '工件', noCorrections: '当前没有记录的更正。',
    }
  : {
      atGlance: 'Evidence & status at a glance', significance: 'Significance', verification: 'Verification', evidence: 'Evidence level', aiRole: 'AI role', assurance: 'Formal assurance',
      onPage: 'On this page', startHere: 'Start here', deeper: 'Detailed record',
      what: 'What happened?', why: 'Why it matters', primaryEvidence: 'Primary evidence', contribution: 'Contribution & verification', technical: 'Technical details', sources: 'Sources & artifacts', relationships: 'Historical context', history: 'Verification history', corrections: 'Corrections',
      rationale: 'Significance rationale: ', novelty: 'Mathematical novelty', interface: 'Interface', aiContribution: 'AI contribution', humanContribution: 'Human contribution', lastReviewed: 'Last reviewed', systems: 'Systems', organizations: 'Organizations', problems: 'Problems', methods: 'Methods', accessed: 'accessed', artifact: 'Artifact', noCorrections: 'No corrections recorded.',
    };
const navPrimary = [
  ['what-happened', labels.what],
  ['why-it-matters', labels.why],
  ['historical-context', labels.relationships],
  ['primary-evidence', labels.primaryEvidence],
] as const;
const navSecondary = [
  ['evidence-status', labels.atGlance],
  ['contribution-verification', labels.contribution],
  ['technical-details', labels.technical],
  ['sources-artifacts', labels.sources],
  ['verification-history', labels.history],
  ['corrections', labels.corrections],
] as const;
const articleJsonLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: eventTitle,
  description,
  datePublished: event.dates.event,
  dateModified: event.dates.last_updated,
  mainEntityOfPage: absolute(canonicalPath),
  about: [...event.systems, ...event.problems, ...event.methods],
  citation: event.sources.map((source) => source.url),
  author: { '@type': 'Organization', name: 'AI4Math Chronicle' },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI4Math Chronicle', item: absolute(localePath(locale)) },
    { '@type': 'ListItem', position: 2, name: eventTitle, item: absolute(canonicalPath) },
  ]
};
---
<BaseLayout locale={locale} title={`${eventTitle} — AI4Math Chronicle`} description={description} canonicalPath={canonicalPath} alternatePath={localePath(other, `events/${event.slug}`)} jsonLd={[articleJsonLd,breadcrumbJsonLd]}>
  <div class="sr-only" data-pagefind-ignore aria-hidden="true">
    <span data-pagefind-filter={`year:${event.dates.event.slice(0, 4)}`}></span>
    {event.event_types.map((value) => <span data-pagefind-filter={`type:${value}`}></span>)}
    <span data-pagefind-filter={`significance:${event.significance.tier}`}></span>
    <span data-pagefind-filter={`verification:${event.verification.status}`}></span>
    {event.systems.map((value) => <span data-pagefind-filter={`system:${value}`}></span>)}
    <span data-pagefind-filter={`ai_role:${event.ai_role.level}`}></span>
    {event.interfaces.map((value) => <span data-pagefind-filter={`interface:${value}`}></span>)}
    <span data-pagefind-filter={`evidence:${event.verification.evidence_level}`}></span>
    <span data-pagefind-filter={`formal_assurance:${event.verification.formal_assurance}`}></span>
    <span data-pagefind-filter={`novelty:${event.mathematical_novelty.type}`}></span>
    {event.organizations.map((value) => <span data-pagefind-filter={`organization:${value}`}></span>)}
    {event.people.map((value) => <span data-pagefind-filter={`person:${value}`}></span>)}
    {event.problems.map((value) => <span data-pagefind-filter={`problem:${value}`}></span>)}
    {event.methods.map((value) => <span data-pagefind-filter={`method:${value}`}></span>)}
    {sourceTypes.map((value) => <span data-pagefind-filter={`source_type:${value}`}></span>)}
    {artifactKinds.map((value) => <span data-pagefind-filter={`artifact_kind:${value}`}></span>)}
    {event.tags.map((value) => <span data-pagefind-filter={`tag:${value}`}></span>)}
  </div>

  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href(localePath(locale))}>{zh ? '时间线' : 'Timeline'}</a><span>/</span><span>{eventTitle}</span></nav>
  <header class="event-header event-detail-header">
    <p class="eyebrow"><time datetime={event.dates.event}>{formatDate(event.dates.event, locale)}</time></p>
    <h1>{eventTitle}</h1>
    <p class="lede">{description}</p>
  </header>

  <div class="event-detail-layout">
    <nav class="event-section-nav" aria-label={labels.onPage}>
      <div class="event-section-nav-inner">
        <strong class="event-section-nav-title">{labels.onPage}</strong>
        <div class="event-section-nav-group">
          <span>{labels.startHere}</span>
          <ul>{navPrimary.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </div>
        <div class="event-section-nav-group event-section-nav-secondary">
          <span>{labels.deeper}</span>
          <ul>{navSecondary.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </div>
      </div>
    </nav>

    <div class="event-detail-main">
      <section id="what-happened" class="event-section event-section-primary"><h2>{labels.what}</h2><p>{text(event.claim, locale)}</p></section>
      <section id="why-it-matters" class="event-section event-section-primary"><h2>{labels.why}</h2><p>{text(event.why_it_matters, locale)}</p><p class="event-rationale"><strong>{labels.rationale}</strong>{text(event.significance.rationale, locale)}</p></section>

      <section id="historical-context" class="event-section event-section-primary"><h2>{labels.relationships}</h2>
        <div class="relationships">{relationGroups.map(([label, ids]) => <div class="fact"><strong>{label}</strong>{ids.length ? <ul>{ids.map((id) => { const related = getEventById(id); return related ? <li><a href={href(localePath(locale, `events/${related.slug}`))}>{text(related.title, locale)}</a></li> : null; })}</ul> : <p>—</p>}</div>)}</div>
      </section>

      <section id="primary-evidence" class="event-section event-section-primary"><h2>{labels.primaryEvidence}</h2>
        <ul class="evidence-list">{primary.map((source) => <li><a href={source.url} rel="noreferrer"><strong>{source.title}</strong></a><div class="source-tier">{presentationLabel('source_tier', source.tier, locale)} · {presentationLabel('source_type', source.type, locale)}{source.published_date ? ` · ${source.published_date}` : ''}</div></li>)}</ul>
      </section>

      <section id="evidence-status" class="event-section event-section-secondary event-at-a-glance" aria-labelledby="event-at-a-glance-heading">
        <h2 id="event-at-a-glance-heading" class="event-at-a-glance-title">{labels.atGlance}</h2>
        <dl class="event-glance-grid">
          <div class="event-glance-item event-glance-primary"><dt>{labels.significance}</dt><dd><span class="badge significance">{presentationLabel('significance', event.significance.tier, locale)}</span></dd></div>
          <div class="event-glance-item event-glance-primary"><dt>{labels.verification}</dt><dd><span class={`badge ${event.verification.status}`}>{presentationLabel('verification', event.verification.status, locale)}</span></dd></div>
          <div class="event-glance-item"><dt>{labels.evidence}</dt><dd>{presentationLabel('evidence_level', event.verification.evidence_level, locale)}</dd></div>
          <div class="event-glance-item"><dt>{labels.aiRole}</dt><dd>{presentationLabel('ai_role', event.ai_role.level, locale)}</dd></div>
          <div class="event-glance-item"><dt>{labels.assurance}</dt><dd>{presentationLabel('formal_assurance', event.verification.formal_assurance, locale)}</dd></div>
        </dl>
      </section>

      <section id="contribution-verification" class="event-section event-section-secondary"><h2>{labels.contribution}</h2>
        <dl class="fact-grid">
          <div class="fact"><dt>{labels.novelty}</dt><dd>{presentationLabel('mathematical_novelty', event.mathematical_novelty.type, locale)}</dd></div>
          <div class="fact"><dt>{labels.interface}</dt><dd>{event.interfaces.map((value) => presentationLabel('interface', value, locale)).join(', ')}</dd></div>
          <div class="fact"><dt>{labels.aiContribution}</dt><dd>{text(event.ai_role.description, locale)}</dd></div>
          <div class="fact"><dt>{labels.humanContribution}</dt><dd>{text(event.human_contribution.description, locale)}</dd></div>
          <div class="fact"><dt>{labels.verification}</dt><dd>{presentationLabel('verification', event.verification.status, locale)} · {presentationLabel('evidence_level', event.verification.evidence_level, locale)} · {presentationLabel('formal_assurance', event.verification.formal_assurance, locale)}</dd></div>
          <div class="fact"><dt>{labels.lastReviewed}</dt><dd>{event.editorial.last_reviewed}</dd></div>
        </dl>
      </section>

      <section id="technical-details" class="event-section event-section-secondary"><h2>{labels.technical}</h2>
        <dl class="fact-grid">
          <div class="fact"><dt>{labels.systems}</dt><dd>{event.systems.join(', ') || '—'}</dd></div>
          <div class="fact"><dt>{labels.organizations}</dt><dd>{event.organizations.join(', ') || '—'}</dd></div>
          <div class="fact"><dt>{labels.problems}</dt><dd>{event.problems.join(', ') || '—'}</dd></div>
          <div class="fact"><dt>{labels.methods}</dt><dd>{event.methods.join(', ') || '—'}</dd></div>
        </dl>
      </section>

      <section id="sources-artifacts" class="event-section event-section-secondary"><h2>{labels.sources}</h2>
        <ul class="evidence-list">{event.sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.title}</a><div class="source-tier">{presentationLabel('source_tier', source.tier, locale)} · {presentationLabel('source_type', source.type, locale)} · {labels.accessed} {source.accessed_at}</div></li>)}</ul>
        {event.artifacts.length > 0 && <ul class="evidence-list">{event.artifacts.map((artifact) => <li><a href={artifact.url} rel="noreferrer">{artifact.title}</a><div class="source-tier">{labels.artifact} · {presentationLabel('artifact_kind', artifact.kind, locale)}</div></li>)}</ul>}
      </section>

      <section id="verification-history" class="event-section event-section-secondary"><h2>{labels.history}</h2>
        <ul class="evidence-list">{event.verification.history.map((item) => <li><strong>{item.date} · {presentationLabel('verification', item.status, locale)} · {presentationLabel('evidence_level', item.evidence_level, locale)}</strong><p>{text(item.note, locale)}</p></li>)}</ul>
      </section>

      <section id="corrections" class="event-section event-section-secondary"><h2>{labels.corrections}</h2>
        {event.corrections.length ? <ul class="evidence-list">{event.corrections.map((item) => <li><strong>{item.date}</strong><p>{text(item.summary, locale)}</p></li>)}</ul> : <p>{labels.noCorrections}</p>}
      </section>
    </div>
  </div>
</BaseLayout>