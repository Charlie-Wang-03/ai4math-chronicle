---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from './SearchBox.astro';
import EventCollection from './EventCollection.astro';
import { getAllEvents } from '../lib/events';
import { localePath, absolute } from '../lib/site';
import type { Locale } from '../lib/types';
const { locale } = Astro.props as { locale: Locale };
const events = getAllEvents();
const copy = locale === 'zh-CN'
  ? { title: 'AI4Math 大事记 — AI for Mathematics 重大进展时间线', desc: '可视化、可搜索、基于证据的 AI for Mathematics 重大进展档案。', eyebrow: 'AI for Mathematics 历史档案', heading: 'AI4Math 这些年发生了什么？', lede: '按时间发现重要里程碑，理解 AI 与人类各自做了什么，并在 1–2 次点击内进入主要证据。', timeline: 'Chronicle 时间线' }
  : { title: 'AI4Math Chronicle — Major Milestones in AI for Mathematics', desc: 'A visual, searchable, evidence-backed chronicle of major milestones in AI for Mathematics.', eyebrow: 'AI for Mathematics historical archive', heading: 'What happened in AI4Math?', lede: 'Discover major milestones chronologically, see what AI and humans contributed, and reach primary evidence in one or two clicks.', timeline: 'Chronicle timeline' };
const websiteJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'AI4Math Chronicle', alternateName: 'AI4Math 大事记', url: absolute(localePath(locale)), description: copy.desc };
---
<BaseLayout locale={locale} title={copy.title} description={copy.desc} canonicalPath={localePath(locale)} alternatePath={localePath(locale === 'en' ? 'zh-CN' : 'en')} jsonLd={websiteJsonLd}>
  <header class="hero">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.heading}</h1>
    <p class="lede">{copy.lede}</p>
  </header>
  <SearchBox locale={locale} />
  <h2>{copy.timeline}</h2>
  <EventCollection events={events} locale={locale} mode="timeline" />
</BaseLayout>
