---
import EventCard from './EventCard.astro';
import MultiSelectFilter from './MultiSelectFilter.astro';
import { formatDate } from '../lib/events';
import { presentationOptions } from '../lib/presentation';
import { href, localePath } from '../lib/site';
import type { ChronicleEvent, Locale } from '../lib/types';
const { events, locale, mode = 'timeline' } = Astro.props as { events: ChronicleEvent[]; locale: Locale; mode?: 'timeline' | 'grid' };
const years = [...new Set(events.map((event) => event.dates.event.slice(0, 4)))].sort((a,b) => b.localeCompare(a));
const eventTypes = ['discovery', 'proof', 'formalization', 'competition', 'system', 'benchmark', 'dataset', 'infrastructure', 'controversy'];
const significance = ['H1', 'H2', 'H3'];
const verification = ['claimed', 'paper_released', 'under_verification', 'partially_verified', 'independently_verified', 'disputed', 'corrected', 'retracted'];
const labels = locale === 'zh-CN'
  ? {
      filters: '收窄时间线', search: '搜索时间线', placeholder: '搜索事件、系统、问题或方法…', searchHint: '至少输入 2 个字符。搜索与筛选共同作用于当前时间线，并始终保持时间顺序。', unavailable: '全文搜索索引暂不可用；结构化筛选仍可使用。',
      year: '年份', type: '事件类型', significance: '重要性', verification: '验证状态', all: '全部', selected: '已选', showing: '显示', events: '个事件', clear: '清除条件', yearNav: '年份导航'
    }
  : {
      filters: 'Refine timeline', search: 'Search timeline', placeholder: 'Search events, systems, problems, or methods…', searchHint: 'Type at least 2 characters. Search and filters refine this timeline without changing chronological order.', unavailable: 'Full-text search is unavailable; structured filters still work.',
      year: 'Year', type: 'Event type', significance: 'Significance', verification: 'Verification', all: 'All', selected: 'selected', showing: 'Showing', events: 'events', clear: 'Clear conditions', yearNav: 'Year navigation'
    };
const controlIds = {
  query: `timeline-query-${locale}`,
  year: `filter-year-${mode}-${locale}`,
  type: `filter-type-${mode}-${locale}`,
  significance: `filter-significance-${mode}-${locale}`,
  verification: `filter-verification-${mode}-${locale}`,
};
---
<section class="panel filter-panel timeline-filter-panel" data-filter-shell data-pagefind-ignore>
  <div class="filter-head">
    <div>
      <p class="eyebrow">{labels.filters}</p>
      <div class="result-count"><strong><span data-visible-count>{events.length}</span></strong> {labels.events}</div>
    </div>
    <button class="clear-filters" type="button" data-clear-filters>{labels.clear}</button>
  </div>
  <div class="timeline-query">
    <label for={controlIds.query}>{labels.search}</label>
    <input class="search-input" id={controlIds.query} data-query type="search" autocomplete="off" placeholder={labels.placeholder} />
    <div class="result-count timeline-query-status" data-query-status role="status" aria-live="polite">{labels.searchHint}</div>
  </div>
  <div class="controls">
    <MultiSelectFilter id={controlIds.year} name="year" label={labels.year} allLabel={labels.all} selectedLabel={labels.selected} options={years.map((value) => ({ value }))} />
    <MultiSelectFilter id={controlIds.type} name="type" label={labels.type} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('event_type', eventTypes, locale)} />
    <MultiSelectFilter id={controlIds.significance} name="significance" label={labels.significance} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('significance', significance, locale)} />
    <MultiSelectFilter id={controlIds.verification} name="verification" label={labels.verification} allLabel={labels.all} selectedLabel={labels.selected} options={presentationOptions('verification', verification, locale)} />
  </div>
  <div class="year-nav" aria-label={labels.yearNav}>
    <button class="year-chip" type="button" data-year-chip="">{labels.all}</button>
    {years.map((year) => <button class="year-chip" type="button" data-year-chip={year}>{year}</button>)}
  </div>
</section>

{mode === 'timeline' ? (
  <ol class="timeline" data-event-list>
    {events.map((event) => {
      const eventUrl = href(localePath(locale, `events/${event.slug}`));
      return <li class="timeline-item" data-event-item data-event-url={eventUrl}><time class="timeline-date" datetime={event.dates.event}>{formatDate(event.dates.event, locale)}</time><span class="timeline-dot" aria-hidden="true"></span><EventCard event={event} locale={locale} /></li>;
    })}
  </ol>
) : (
  <div class="grid-list" data-event-list>{events.map((event) => <div data-event-item data-event-url={href(localePath(locale, `events/${event.slug}`))}><EventCard event={event} locale={locale} showDate /></div>)}</div>
)}

<script>
  // @ts-nocheck
  const baseUrl = import.meta.env.BASE_URL;
  let pagefindPromise;

  function normalizePath(value) {
    try {
      const path = new URL(value, window.location.origin).pathname;
      return path.endsWith('/') ? path : `${path}/`;
    } catch {
      return value;
    }
  }

  async function getPagefind() {
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        const moduleUrl = `${baseUrl}pagefind/pagefind.js`;
        const engine = await import(/* @vite-ignore */ moduleUrl);
        await engine.options({ baseUrl });
        return engine;
      })();
    }
    return pagefindPromise;
  }

  for (const shell of document.querySelectorAll('[data-filter-shell]')) {
    const list = shell.nextElementSibling;
    if (!list) continue;
    const items = [...list.querySelectorAll('[data-event-item]')];
    const groups = [...shell.querySelectorAll('[data-multi-filter]')];
    const input = shell.querySelector('[data-query]');
    const status = shell.querySelector('[data-query-status]');
    const count = shell.querySelector('[data-visible-count]');
    const chips = [...shell.querySelectorAll('[data-year-chip]')];
    const clearButton = shell.querySelector('[data-clear-filters]');
    const filters = Object.fromEntries(groups.map((group) => [group.dataset.filter, []]));
    let timer;
    let requestId = 0;

    function selectedValues(group) {
      return [...group.querySelectorAll('[data-filter-option]:checked')].map((input) => input.value);
    }

    function optionLabel(group, value) {
      const option = [...group.querySelectorAll('[data-filter-option]')].find((input) => input.value === value);
      return option?.closest('label')?.querySelector('span')?.textContent?.trim() || value;
    }

    function updateSummary(group) {
      const summary = group.querySelector('[data-filter-summary]');
      if (!summary) return;
      const values = selectedValues(group);
      if (!values.length) summary.textContent = group.dataset.allLabel || 'All';
      else if (values.length <= 2) summary.textContent = values.map((value) => optionLabel(group, value)).join(', ');
      else summary.textContent = `${values.length} ${group.dataset.selectedLabel || 'selected'}`;
    }

    function syncGroup(group) {
      filters[group.dataset.filter] = selectedValues(group);
      updateSummary(group);
    }

    function setGroupValues(key, values) {
      const group = groups.find((candidate) => candidate.dataset.filter === key);
      if (!group) return;
      const selected = new Set(values);
      for (const option of group.querySelectorAll('[data-filter-option]')) option.checked = selected.has(option.value);
      syncGroup(group);
    }

    function matches(selected, candidates) {
      return !selected.length || selected.some((value) => candidates.includes(value));
    }

    function pagefindFilterState() {
      return Object.fromEntries(Object.entries(filters)
        .filter(([, values]) => values.length)
        .map(([key, values]) => [key, { any: values }]));
    }

    function setVisibility(predicate) {
      let visible = 0;
      for (const item of items) {
        const shown = predicate(item);
        item.classList.toggle('hidden', !shown);
        if (shown) visible += 1;
      }
      if (count) count.textContent = String(visible);
      for (const chip of chips) {
        const year = chip.dataset.yearChip || '';
        chip.dataset.active = String(year ? filters.year.includes(year) : filters.year.length === 0);
      }
      const hasQuery = Boolean(input?.value.trim());
      if (clearButton) clearButton.disabled = !hasQuery && !Object.values(filters).some((values) => values.length);
    }

    function fallback() {
      const query = input?.value.trim().toLocaleLowerCase() || '';
      setVisibility((item) => {
        const card = item.querySelector('[data-event-card]');
        if (!card) return false;
        const structured = matches(filters.year, [card.dataset.year])
          && matches(filters.type, (card.dataset.eventTypes || '').split(' ').filter(Boolean))
          && matches(filters.significance, [card.dataset.significance])
          && matches(filters.verification, [card.dataset.verification]);
        const textMatch = query.length < 2 || item.textContent.toLocaleLowerCase().includes(query);
        return structured && textMatch;
      });
    }

    async function apply() {
      const currentRequest = ++requestId;
      const rawQuery = input?.value.trim() || '';
      const query = rawQuery.length >= 2 ? rawQuery : null;
      const pagefindFilters = pagefindFilterState();
      const hasConditions = Boolean(query) || Object.keys(pagefindFilters).length > 0;

      if (!hasConditions) {
        setVisibility(() => true);
        if (status) status.textContent = rawQuery.length === 1
          ? (document.documentElement.lang === 'zh-CN' ? '至少输入 2 个字符。' : 'Type at least 2 characters.')
          : (document.documentElement.lang === 'zh-CN'
              ? '至少输入 2 个字符。搜索与筛选共同作用于当前时间线，并始终保持时间顺序。'
              : 'Type at least 2 characters. Search and filters refine this timeline without changing chronological order.');
        return;
      }

      try {
        const engine = await getPagefind();
        const search = await engine.search(query, { filters: pagefindFilters });
        const results = await Promise.all(search.results.map((result) => result.data()));
        if (currentRequest !== requestId) return;
        const matched = new Set(results.map((result) => normalizePath(result.url)));
        setVisibility((item) => matched.has(normalizePath(item.dataset.eventUrl || '')));
        if (status) status.textContent = document.documentElement.lang === 'zh-CN'
          ? `搜索与筛选后匹配 ${matched.size} 个事件；时间顺序保持不变。`
          : `${matched.size} events match the current search and filters; chronology is unchanged.`;
      } catch (error) {
        console.warn('Pagefind unavailable', error);
        fallback();
        if (status) status.textContent = document.documentElement.lang === 'zh-CN'
          ? '全文搜索索引暂不可用；结构化筛选仍可使用。'
          : 'Full-text search is unavailable; structured filters still work.';
      }
    }

    function scheduleApply() {
      window.clearTimeout(timer);
      timer = window.setTimeout(apply, 180);
    }

    for (const group of groups) {
      syncGroup(group);
      group.addEventListener('change', (event) => {
        if (!event.target.matches('[data-filter-option]')) return;
        syncGroup(group);
        void apply();
      });
    }
    input?.addEventListener('focus', () => { void getPagefind().catch(() => {}); }, { once: true });
    input?.addEventListener('input', scheduleApply);
    for (const chip of chips) chip.addEventListener('click', () => {
      const year = chip.dataset.yearChip || '';
      if (!year) {
        setGroupValues('year', []);
      } else {
        const next = new Set(filters.year);
        if (next.has(year)) next.delete(year); else next.add(year);
        setGroupValues('year', [...next]);
      }
      void apply();
    });
    clearButton?.addEventListener('click', () => {
      if (input) input.value = '';
      for (const group of groups) setGroupValues(group.dataset.filter, []);
      void apply();
    });
    void apply();
  }
</script>

<style>
  .timeline-query { margin-top: 1rem; }
  .timeline-query label { display: block; margin: 0 0 .28rem; color: var(--muted); font-size: .78rem; font-weight: 680; }
  .timeline-query-status { margin-top: .35rem; }
</style>